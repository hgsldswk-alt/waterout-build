    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used to route the earpiece test tone to the earpiece. Nothing is recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于把听筒测试音切到听筒播放，不会录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於把聽筒測試音切到聽筒播放，不會錄音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受話口のテスト音を受話口から流すためだけに使います。録音はしません。"
          }
        }
      },
