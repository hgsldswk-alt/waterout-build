    "check.stereoNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a side to replay it. If both sound centered, check Settings › Accessibility › Audio & Visual › Mono Audio. Channel labels describe the audio signal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点任一侧可重听。如果两侧听起来都居中，请检查「设置 › 辅助功能 › 音频与视觉 › 单声道音频」。左右表示音频声道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點任一側可重聽。如果兩側聽起來都在中央，請檢查「設定 › 輔助使用 › 音訊與視覺 › 單聲道音訊」。左右表示音訊聲道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片側をタップするともう一度再生します。両方とも中央から聞こえる場合は「設定」›「アクセシビリティ」›「オーディオとビジュアル」›「モノラルオーディオ」を確認してください。チャンネル名は音声信号の左右を表します。"
          }
        }
      },
      "extractionState": "manual"
    },
