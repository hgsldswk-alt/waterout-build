    },
    "help.wet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Apple’s drying guidance. If you see a liquid alert, unplug the cable and let the connector dry before charging again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Apple 指引干燥设备。如果收到液体警报，请拔掉线缆，等接口干燥后再充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 Apple 指引乾燥裝置。如果收到液體警報，請拔下連接線，等接頭乾燥後再充電。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの乾燥方法に従ってください。液体の検出アラートが出たら、ケーブルを抜き、コネクタが乾いてから充電してください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "help.limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app plays sound and lets you record what you hear. The timer shows playback time. It cannot detect liquid or assess damage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用播放声音并记录你选择的听感。倒计时仅表示播音时间，无法检测液体或判断设备损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 播放聲音並記錄你選擇的聽感。倒數僅表示播放時間，無法偵測液體或判斷裝置損壞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは音を再生し、聞こえ方を記録できます。タイマーは再生時間を表示します。液体の検出や損傷の判断はできません。"
          }
        }
      },
      "extractionState": "manual"
    },
