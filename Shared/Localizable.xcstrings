    "help.silent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the timer moves and you hear nothing, stop, check the output, then raise the device volume gradually and replay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果倒计时在走但听不到，请停止、确认输出，再逐步调高设备音量后重播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果倒數在走但聽不到，請停止、確認輸出，再逐步調高裝置音量後重播。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーが進んでいるのに何も聞こえない場合は、停止して出力先を確認し、端末の音量を少しずつ上げてから再生し直してください。"
          }
        }
      },
      "extractionState": "manual"
