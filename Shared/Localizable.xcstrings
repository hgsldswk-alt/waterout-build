    "tone.safety": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at a low volume. Keep the speaker away from your ear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从低音量开始，播放时请勿把外放贴近耳朵。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從低音量開始，播放時請勿把揚聲器貼近耳朵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな音量から始めてください。スピーカーを耳から離してください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "tone.autoStop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cycle stops automatically. Adjust sound with the iPhone volume buttons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮会自动停止。可用 iPhone 音量键调节声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本輪會自動停止。可用 iPhone 音量鍵調整聲音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイクルは自動で止まります。音量はiPhoneの音量ボタンで調整してください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "tone.after": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After playback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放结束后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放結束後"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生後"
          }
        }
      },
      "extractionState": "manual"
    },
    "tone.afterHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay, run a sound check or open the checklist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以重播、做听感自检或查看自检卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以重播、做聽感自檢或查看自檢卡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度再生するか、サウンドチェックやチェックリストを開いてください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.preparing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PREPARING SOUND"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备声音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備聲音"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音を準備中"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not play this sound. Check the output and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放。请确认音频输出后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法播放。請確認音訊輸出後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音を再生できませんでした。出力先を確認してもう一度お試しください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.external": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to iPhone to play this sound."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请切换到 iPhone 后播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請切換到 iPhone 後播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音を再生するにはiPhoneに切り替えてください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.switch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the output picker or Control Center to choose iPhone, or disconnect the external device. Then tap play again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输出选择器或控制中心选 iPhone，也可断开外部设备。切换后请手动重播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸出選擇器或控制中心選 iPhone，也可中斷外部裝置連線。切換後請手動重播。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力先の選択かコントロールセンターでiPhoneを選ぶか、外部機器の接続を外してから、もう一度再生をタップしてください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.speaker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone speaker could not be confirmed. Check the output before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认 iPhone 外放。请检查输出后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能確認 iPhone 揚聲器。請檢查輸出後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのスピーカーを確認できませんでした。再試行する前に出力先を確認してください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.receiver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earpiece route is unavailable. You can try an ordinary speaker sample instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认听筒输出。可改用普通外放试听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認聽筒輸出。可改用一般揚聲器試聽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受話口の経路を使えません。代わりに通常のスピーカー用サンプルをお試しください。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.mono": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mono audio is active or this output has one channel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用单声道音频，或当前输出只有一个声道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用單聲道音訊，或目前輸出只有一個聲道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モノラルオーディオがオンか、この出力先は1チャンネルです。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.stereoUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stereo capability could not be confirmed for this output."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认当前输出支持双声道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認目前輸出支援雙聲道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この出力先がステレオに対応しているか確認できませんでした。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
